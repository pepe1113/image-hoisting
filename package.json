{
  "name": "r2-image-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm run build && concurrently --kill-others \"pnpm --filter @image-hoisting/web dev\" \"pnpm run dev:worker\"",
    "dev:worker": "pnpm --filter @image-hoisting/gateway dev",
    "build": "pnpm --filter @image-hoisting/web build",
    "deploy": "pnpm check && pnpm --filter @image-hoisting/gateway deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config apps/web/vite.config.ts --root .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && node scripts/health-smoke.mjs --self-test && pnpm run build",
    "smoke": "node scripts/health-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.4",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
